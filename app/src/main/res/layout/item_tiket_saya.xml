<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Kepala: nama pemesan + badge status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvKetua"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Andi Pratama"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                tools:text="Sedang Mendaki"
                android:background="@drawable/border_tiket"
                android:textColor="@color/black2"
                android:textSize="12sp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvCreatedAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Pemesanan 11 Januari 2025"
            android:textColor="@color/softgrey"
            android:textSize="12sp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:layout_marginTop="4dp"/>

        <!-- Label tambahan (overstay): lewat jadwal turun / biaya tambahan -->
        <TextView
            android:id="@+id/tvOverstayLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/softyellow"
            android:textColor="#8A6100"
            android:textSize="12sp"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:padding="8dp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Lewat jadwal turun"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/pstlabu"
            android:layout_marginTop="12dp"/>

        <!-- Grid informasi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Masuk"
                    android:textColor="@color/softgrey"
                    android:textSize="12sp"
                    android:fontFamily="@font/plus_jakarta_sans"/>

                <TextView
                    android:id="@+id/tvTanggalMasuk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="20 Februari 2025"
                    android:textColor="@color/black2"
                    android:textSize="14sp"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gerbang"
                    android:textColor="@color/softgrey"
                    android:textSize="12sp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvGerbang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Kersik Tuo"
                    android:textColor="@color/black2"
                    android:textSize="14sp"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keluar"
                    android:textColor="@color/softgrey"
                    android:textSize="12sp"
                    android:fontFamily="@font/plus_jakarta_sans"/>

                <TextView
                    android:id="@+id/tvTanggalKeluar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="25 Februari 2025"
                    android:textColor="@color/black2"
                    android:textSize="14sp"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pendaki"
                    android:textColor="@color/softgrey"
                    android:textSize="12sp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvPendaki"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="2 WNI + 1 WNA"
                    android:textColor="@color/black2"
                    android:textSize="14sp"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Pembayaran tiket awal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Pembayaran"
                android:textColor="@color/softgrey"
                android:textSize="12sp"
                android:fontFamily="@font/plus_jakarta_sans"/>

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Rp 150.000"
                android:textColor="@color/black2"
                android:textSize="14sp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
