<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Homepage.HomeFragment"
    android:background="@color/white">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/halo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Halo!"
                    android:textSize="16sp"
                    android:textColor="@color/black2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:id="@+id/User"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="16sp"
                    app:layout_constraintTop_toTopOf="@id/halo"
                    app:layout_constraintBottom_toBottomOf="@id/halo"
                    app:layout_constraintStart_toEndOf="@id/halo"
                    app:layout_constraintEnd_toStartOf="@id/buttonNotif"
                    android:layout_marginEnd="12dp"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="@color/black2" />
                
                <FrameLayout
                    android:id="@+id/buttonNotif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="20dp">
                    
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/notif"
                        android:background="@drawable/circle_shape"
                        android:padding="5dp"
                        android:contentDescription="Notification Icon"/>
                    
                </FrameLayout>

                <TextView
                    android:id="@+id/selamat"
                    android:layout_width="290dp"
                    android:layout_height="wrap_content"
                    android:text="SELAMAT DATANG DI GUNUNG KERINCI"
                    android:textColor="@color/primary"
                    android:textSize="28sp"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    app:layout_constraintTop_toBottomOf="@id/halo"
                    app:layout_constraintStart_toStartOf="@id/halo"
                    android:layout_marginTop="10dp"/>

                <ImageView
                    android:id="@+id/gambar"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="360:214"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/home_hero_figma"
                    android:scaleType="fitXY"
                    app:layout_constraintTop_toBottomOf="@id/selamat"
                    android:layout_marginTop="10dp"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCuaca"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintStart_toStartOf="@id/gambar"
                    app:layout_constraintEnd_toEndOf="@id/gambar"
                    app:layout_constraintTop_toBottomOf="@id/gambar"
                    app:layout_constraintBottom_toBottomOf="@id/gambar"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="57dp" android:paddingHorizontal="20dp" android:paddingVertical="8dp"
                        android:orientation="vertical">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/grupKontenCuaca" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:visibility="gone">
                            <LinearLayout android:id="@+id/weatherGroup" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                                <TextView android:id="@+id/suhu" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="—" android:textSize="18sp" android:fontFamily="@font/poppins_bold" android:textColor="#1E1E1E"/>
                                <TextView android:id="@+id/ketSuhu" android:layout_width="42dp" android:layout_height="wrap_content"
                                    android:text="—" android:textSize="10sp" android:fontFamily="@font/poppins_regular"
                                    android:textColor="#1E1E1E" android:gravity="center"/>
                            </LinearLayout>
                            <LinearLayout android:id="@+id/locationGroup" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:orientation="vertical">
                                <TextView android:id="@+id/ketKota" android:layout_width="76dp" android:layout_height="wrap_content"
                                    android:text="—" android:textSize="12sp" android:fontFamily="@font/plus_jakarta_sans_semibold" android:textColor="#1E1E1E"/>
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                                    <ImageView android:id="@+id/iconStatus" android:layout_width="12dp" android:layout_height="12dp"
                                        android:src="@drawable/home_mountain_status_figma" android:contentDescription="@null"/>
                                    <TextView android:id="@+id/statusGunung" android:layout_width="60dp" android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp" android:text="—" android:textSize="10sp"
                                        android:fontFamily="@font/poppins_bold" android:textColor="#B42318"/>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout android:id="@+id/hikerGroup" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:orientation="vertical">
                                <TextView android:id="@+id/pendakiNow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="—/— Total Pendaki" android:textSize="18sp"
                                    android:fontFamily="@font/poppins_bold" android:textColor="#1E1E1E"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Orang saat ini" android:textSize="10sp"
                                    android:fontFamily="@font/poppins_regular" android:textColor="#1E1E1E"/>
                            </LinearLayout>
                            <androidx.constraintlayout.helper.widget.Flow android:layout_width="0dp" android:layout_height="wrap_content"
                                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                                app:constraint_referenced_ids="weatherGroup,locationGroup,hikerGroup"
                                app:flow_wrapMode="chain" app:flow_horizontalGap="9dp" app:flow_verticalGap="8dp"
                                app:flow_horizontalStyle="spread_inside" app:flow_verticalAlign="center"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <LinearLayout android:id="@+id/weatherNoticeRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/loadingCuaca" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:indeterminate="true" app:indicatorSize="18dp" app:trackThickness="2dp" app:indicatorColor="@color/primary"/>
                            <TextView android:id="@+id/weatherNotice" android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:layout_marginStart="8dp" android:text="Memuat informasi..."
                                android:textSize="12sp" android:textColor="#475467"/>

                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Menu Berkas (6 item: 4 atas, 2 bawah) — Compose, disamakan dengan repo vibe-coding -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/composeViewBerkasMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="220dp"
                android:layout_marginTop="24dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiket Anda Saat Ini"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"/>

            <!-- Kartu "Tiket Anda Saat Ini" (Compose, pakai ulang kartu layar Pelacakan Jejak).
                 Ditampilkan hanya kalau ada booking status 6; kalau tidak, layoutBelumAda yang tampil. -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/composeViewTiketAktif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutBelumAda"
                android:layout_width="match_parent"
                android:layout_height="348dp"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/ticket_empty_background"
                android:clickable="true">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="65dp"
                    android:alpha="0.6"
                    android:src="@drawable/ticket_empty_figma"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anda belum membuat pesanan\nPesan Tiket Anda Sekarang!"
                    android:textColor="@color/grey"
                    android:textSize="14sp"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:textAlignment="center"/>

            </LinearLayout>


            <FrameLayout
                android:id="@+id/buttonPesanTiket"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/border_blue2"
                android:layout_marginEnd="26dp"
                android:layout_marginStart="26dp"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_plus2"
                        android:contentDescription="@null"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Pesan Tiket"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/plus_jakarta_sans_bold"/>
                </LinearLayout>
            </FrameLayout>

            <androidx.compose.ui.platform.ComposeView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="220dp"
                android:layout_marginTop="24dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp">

                <TextView
                    android:id="@+id/textBeritaTerkini"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:textSize="20sp"
                    android:text="Wisata Alam TNKS"
                    android:textColor="@color/black"
                    android:layout_marginStart="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/textViewSelengkapnya"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lihat Lainnya"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="14sp"
                    android:textColor="@color/primary"
                    app:layout_constraintTop_toTopOf="@id/textBeritaTerkini"
                    app:layout_constraintBottom_toBottomOf="@id/textBeritaTerkini"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="10dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView_wisata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textBeritaTerkini"
                    tools:listitem="@layout/item_wisata" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </ScrollView>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composePeringatan"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
