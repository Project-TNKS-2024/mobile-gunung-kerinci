<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Ticket.TiketFragment"
    android:background="@color/white">

    <ImageButton
        android:id="@+id/buttonBack"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/border_back2"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="26dp"/>

    <TextView
        android:id="@+id/textTiket"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tiket"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:textColor="@color/primary"
        android:textSize="24sp"
        app:layout_constraintTop_toTopOf="@id/buttonBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/buttonBack"
        app:layout_constraintEnd_toEndOf="parent"/>

    <FrameLayout
        android:id="@+id/menuContainer"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toBottomOf="@id/textTiket"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Two menu labels in horizontal -->
        <LinearLayout
            android:id="@+id/menuRow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMenuLeft"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Draft"
                android:textSize="16sp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:textColor="@color/primary"/>

            <TextView
                android:id="@+id/tvMenuRight"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Tiket Saya"
                android:textSize="16sp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:textColor="@color/darkgrey"/>

        </LinearLayout>

        <!-- Indicator: tinggi 3dp, latar biru, akan digeser via kode -->
        <View
            android:id="@+id/viewIndicator"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="@color/primary"/>

    </FrameLayout>

    <!-- divider tipis bawah menu -->
    <View
        android:id="@+id/viewDivider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:background="#B3B3B3"
        app:layout_constraintTop_toBottomOf="@id/menuContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="0dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"/>

    <LinearLayout android:id="@+id/layoutRefresh" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="26dp" android:paddingEnd="26dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="#FEEBBB" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/viewDivider" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressRefresh" android:layout_width="18dp" android:layout_height="18dp" android:indeterminate="true" app:indicatorSize="18dp" app:trackThickness="2dp"/>
        <TextView android:id="@+id/tvRefresh" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Memperbaruiâ€¦" android:textSize="12sp" android:textColor="#444444"/>
        <TextView android:id="@+id/btnRefreshRetry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="Coba lagi" android:textColor="@color/primary" android:visibility="gone"/>
    </LinearLayout>
    <!-- Loading -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:indeterminate="true"
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/viewDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"/>

    <!-- Error -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/viewDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:layout_marginTop="40dp">

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gagal memuat tiket"
            android:textColor="@color/grey"
            android:textSize="14sp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:textAlignment="center"/>

        <TextView
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="120dp"
            android:gravity="center"
            android:text="Coba lagi"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

    <!-- Empty -->
    <LinearLayout
        android:id="@+id/layoutBelumAda"
        android:layout_width="match_parent"
        android:layout_height="348dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/viewDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/ticket_empty_background"
        android:clickable="true">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="65dp"
            android:alpha="0.6"
            android:src="@drawable/ticket_empty_figma"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvEmptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anda belum membuat pesanan\nPesan Tiket Anda Sekarang!"
            android:textColor="@color/grey"
            android:textSize="14sp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:textAlignment="center"/>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/buttonPesanTiket"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/border_blue2"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutBelumAda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="26dp"
        android:layout_marginStart="26dp"
        android:clickable="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_plus2" android:contentDescription="@null"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Pesan Tiket" android:textSize="16sp" android:textColor="@color/white" android:fontFamily="@font/plus_jakarta_sans_bold"/>
        </LinearLayout>
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTiket"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutRefresh"
        android:layout_marginTop="28dp"
        android:clipToPadding="false"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingBottom="80dp"
        tools:listitem="@layout/item_tiket_saya"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Pesan tiket baru"
        android:backgroundTint="@color/primary"
        app:fabCustomSize="48dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="40dp"
        app:layout_anchorGravity="right|bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/ic_plus2"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>
