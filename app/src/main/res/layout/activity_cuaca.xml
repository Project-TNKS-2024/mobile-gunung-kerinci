<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Homepage.Cuaca.CuacaActivity">

    <ImageView
        android:id="@+id/imageDesk"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/foto_cuaca"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"/>

    <ImageButton
        android:id="@+id/buttonBack"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/border_back2"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/textCuaca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cuaca"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintTop_toTopOf="@id/buttonBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/imageWeather"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textCuaca"
        android:src="@drawable/rain_cloud"
        android:layout_marginTop="10dp"
        android:layout_marginStart="90dp"/>

    <TextView
        android:id="@+id/textTemperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="21°c"
        android:textColor="@color/white"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:textSize="42dp"
        app:layout_constraintTop_toTopOf="@id/imageWeather"
        app:layout_constraintBottom_toBottomOf="@id/imageWeather"
        app:layout_constraintStart_toEndOf="@id/imageWeather"
        android:layout_marginStart="10dp"/>

    <ImageView
        android:id="@+id/btnRefresh"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/icon_refresh"
        app:layout_constraintTop_toTopOf="@id/textTemperature"
        app:layout_constraintBottom_toBottomOf="@id/textTemperature"
        app:layout_constraintStart_toEndOf="@id/textTemperature"
        android:layout_marginStart="15dp"/>

    <TextView
        android:id="@+id/textWeatherStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gerimis Ringan"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        android:layout_marginTop="125dp"
        app:layout_constraintTop_toBottomOf="@id/textCuaca"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/textWeatherStatus"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="17dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp">

                <!-- CARD KERSIK TUO -->
                <androidx.cardview.widget.CardView
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#B3FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Perkiraan Cuaca Jalur Kersik Tuo"
                            android:textColor="@color/black2"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textSize="16sp"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvKersikTuo"
                            android:layout_width="match_parent"
                            android:layout_height="370dp"
                            android:layout_marginTop="10dp"
                            tools:listitem="@layout/item_cuaca" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- CARD SOLOK SELATAN -->
                <androidx.cardview.widget.CardView
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#B3FFFFFF"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Perkiraan Cuaca Jalur Solok Selatan"
                            android:textColor="@color/black2"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textSize="16sp"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvSolokSelatan"
                            android:layout_width="match_parent"
                            android:layout_height="370dp"
                            android:layout_marginTop="10dp"
                            tools:listitem="@layout/item_cuaca"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="25dp">

                <!-- CARD PENDAKI -->
                <androidx.cardview.widget.CardView
                    android:layout_width="360dp"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#B3FFFFFF"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/textPendaki"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Jumlah Pendaki"
                                android:textColor="@color/black2"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:textSize="16dp"
                                tools:ignore="MissingConstraints" />

                            <TextView
                                android:id="@+id/textStatusGunung"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Waspada I"
                                android:textColor="@color/red"
                                android:fontFamily="@font/plus_jakarta_sans_semibold"
                                android:textSize="14dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                tools:ignore="MissingConstraints" />

                            <ImageView
                                android:id="@+id/iconStatus"
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:src="@drawable/ket_status"
                                app:layout_constraintTop_toTopOf="@id/textStatusGunung"
                                app:layout_constraintBottom_toBottomOf="@id/textStatusGunung"
                                app:layout_constraintEnd_toStartOf="@id/textStatusGunung"
                                android:layout_marginEnd="10dp"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="15dp"
                            android:layout_marginTop="15dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:paddingTop="7dp"
                                    android:paddingBottom="15dp">

                                    <androidx.constraintlayout.widget.ConstraintLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content">

                                        <TextView
                                            android:id="@+id/textPendakiHariIniA"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="100"
                                            android:textSize="24sp"
                                            android:textColor="@color/primary"
                                            android:fontFamily="@font/plus_jakarta_sans_semibold"
                                            android:layout_marginBottom="5dp"
                                            app:layout_constraintStart_toStartOf="parent"/>

                                        <TextView
                                            android:id="@+id/textAtauA"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="/"
                                            android:textSize="24sp"
                                            android:textColor="@color/primary"
                                            android:fontFamily="@font/plus_jakarta_sans_semibold"
                                            android:layout_marginBottom="5dp"
                                            app:layout_constraintStart_toEndOf="@id/textPendakiHariIniA"/>

                                        <TextView
                                            android:id="@+id/textMaxPendakiA"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="100"
                                            android:textSize="24sp"
                                            android:textColor="@color/primary"
                                            android:fontFamily="@font/plus_jakarta_sans_semibold"
                                            android:layout_marginBottom="5dp"
                                            app:layout_constraintStart_toEndOf="@id/textAtauA"/>

                                    </androidx.constraintlayout.widget.ConstraintLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Orang"
                                        android:textSize="12dp"
                                        android:textColor="@color/black2"
                                        android:fontFamily="@font/plus_jakarta_sans_medium"
                                        android:layout_marginBottom="10dp"/>

                                    <TextView
                                        android:id="@+id/textNamaGateA"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=""
                                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                                        android:textColor="@color/black2"
                                        android:textSize="14dp"/>

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:paddingTop="7dp"
                                    android:paddingBottom="15dp">

                                    <androidx.constraintlayout.widget.ConstraintLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content">

                                        <TextView
                                            android:id="@+id/textPendakiHariIniB"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="100"
                                            android:textSize="24sp"
                                            android:textColor="@color/primary"
                                            android:fontFamily="@font/plus_jakarta_sans_semibold"
                                            android:layout_marginBottom="5dp"
                                            app:layout_constraintStart_toStartOf="parent"/>

                                        <TextView
                                            android:id="@+id/textAtauB"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="/"
                                            android:textSize="24sp"
                                            android:textColor="@color/primary"
                                            android:fontFamily="@font/plus_jakarta_sans_semibold"
                                            android:layout_marginBottom="5dp"
                                            app:layout_constraintStart_toEndOf="@id/textPendakiHariIniB"/>

                                        <TextView
                                            android:id="@+id/textMaxPendakiB"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="100"
                                            android:textSize="24sp"
                                            android:textColor="@color/primary"
                                            android:fontFamily="@font/plus_jakarta_sans_semibold"
                                            android:layout_marginBottom="5dp"
                                            app:layout_constraintStart_toEndOf="@id/textAtauB"/>

                                    </androidx.constraintlayout.widget.ConstraintLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Orang"
                                        android:textSize="12dp"
                                        android:textColor="@color/black2"
                                        android:fontFamily="@font/plus_jakarta_sans_medium"
                                        android:layout_marginBottom="10dp"/>

                                    <TextView
                                        android:id="@+id/textNamaGateB"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=""
                                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                                        android:textColor="@color/black2"
                                        android:textSize="14dp"/>

                                </LinearLayout>

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>